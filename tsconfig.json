{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Node runs the scripts and the tests as they are, by stripping the types, so nothing that
    // needs compiling (enums, parameter properties) may be written.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    // TypeScript 6 loads no @types package unless it is named here. vite/client types what a story
    // imports that is not code: a stylesheet, a guideline as text (`./Page.md?raw`).
    "types": ["node", "vite/client"]
  },
  "include": ["scripts", "src", ".storybook"]
}
