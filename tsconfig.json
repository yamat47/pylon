{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Node runs the scripts and the tests as they are, by stripping the types, so nothing that
    // needs compiling (enums, parameter properties) may be written.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    // TypeScript 6 loads no @types package unless it is named here.
    "types": ["node"]
  },
  "include": ["scripts"]
}
